# Headers for the static marketing site. Pages applies this file to static
# assets only; the app and admin responses come from the worker, which sets the
# same headers in code (see the middleware after `const app = new Hono` in
# src/index.tsx). No CSP yet: the pages run inline scripts and load fonts and
# images from several hosts, so a CSP needs its own change with a report-only
# phase first.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# How long a phone may keep each kind of file. Cloudflare's default was four
# hours for everything, so a visitor back the next day downloaded the site
# again. Scripts and stylesheets are asked for with a ?v= that changes when they
# do (handbook rule 9; Tailwind's is a build hash), so a week is safe; the fonts
# never change in place. The icon fonts keep their names when the subset is
# rebuilt (public/sw.js precaches them by name), so they get a day, like a
# picture replaced under the same name.
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=604800
/webfonts/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=86400
/cdn/*
  Cache-Control: public, max-age=86400
/static/*
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
